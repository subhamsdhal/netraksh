# =============================================================================
# NETRAKSH: Environment Configuration Template
# =============================================================================
# INSTRUCTIONS:
#   1. Copy this file:    cp .env.example .env
#   2. Fill in all values marked REQUIRED (production will fail to start otherwise)
#   3. NEVER commit the actual .env file — it is gitignored
#   4. To generate a secure random key:  python -c "import secrets; print(secrets.token_hex(32))"
#      or:                               openssl rand -hex 32
# =============================================================================


# =============================================================================
# ENVIRONMENT MODE
# =============================================================================
# Controls startup validation strictness.
# "production"  — fails fast if unsafe defaults are detected
# "development" — lenient defaults allowed for local dev
ENV=<production|development>

# =============================================================================
# JWT / AUTH
# =============================================================================
# REQUIRED in production. Must be at least 32 hex characters (256 bits).
SECRET_KEY=<REQUIRED_PRODUCTION_SECRET>

# =============================================================================
# EDGE AUTH
# =============================================================================
# Required in production. Set the same high-entropy value on approved edge devices.
EDGE_AUTH_TOKEN=<REQUIRED_PRODUCTION_EDGE_TOKEN>

# =============================================================================
# BOOTSTRAP POLICY
# =============================================================================
# Automatic privileged-user bootstrap is DISABLED by default in production.
# To bootstrap on first deployment, set BOOTSTRAP_USERS=true and provide strong passwords.
BOOTSTRAP_USERS=<true|false>
ADMIN_PASSWORD=<REQUIRED_IF_BOOTSTRAPPING>
INITIAL_OPERATOR_PASSWORD=<REQUIRED_IF_BOOTSTRAPPING>
INITIAL_AUDITOR_PASSWORD=<REQUIRED_IF_BOOTSTRAPPING>

# =============================================================================
# DATABASE
# =============================================================================
# REQUIRED. Format: postgresql://<user>:<password>@<host>:<port>/<db>
POSTGRES_USER=<REQUIRED>
POSTGRES_PASSWORD=<REQUIRED>
POSTGRES_DB=<REQUIRED>
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# =============================================================================
# OBJECT STORAGE
# =============================================================================
# Storage backend: "local" or "s3"
OBJECT_STORAGE_PROVIDER=<local|s3>

MINIO_ROOT_USER=<REQUIRED_IF_MINIO_USED>
MINIO_ROOT_PASSWORD=<REQUIRED_IF_MINIO_USED>

OBJECT_STORAGE_ENDPOINT=<REQUIRED_IF_S3>
OBJECT_STORAGE_BUCKET=<REQUIRED_IF_S3>
OBJECT_STORAGE_ACCESS_KEY=<REQUIRED_IF_S3>
OBJECT_STORAGE_SECRET_KEY=<REQUIRED_IF_S3>

# =============================================================================
# CRYPTOGRAPHY
# =============================================================================
# Evidence keys (AES / Ed25519) configurations if applicable
# ...

# =============================================================================
# CORS
# =============================================================================
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=<http://localhost:5173,https://your-production-domain.com>
FRONTEND_ORIGIN=<https://your-production-domain.com>

# =============================================================================
# mTLS
# =============================================================================
# mTLS is not yet implemented. Set MTLS_MODE=disabled.
MTLS_MODE=disabled

# =============================================================================
# FRONTEND BUILD / RUNTIME URLS
# =============================================================================
# Production builds must use public HTTPS/WSS URLs; never commit real values.
VITE_BACKEND_URL=<https://your-render-service.onrender.com>
VITE_WS_URL=<wss://your-render-service.onrender.com/ws/dashboard>
